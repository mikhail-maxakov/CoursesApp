<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="backgroundTint">@color/accent_green</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.App.Button.Social" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/stroke_color</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="backgroundTint">@color/bg_surface</item>
    </style>

    <style name="Widget.App.Button.Icon" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/bg_surface</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="iconTint">@color/text_secondary</item>
        <item name="strokeColor">@color/stroke_color</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:text">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
